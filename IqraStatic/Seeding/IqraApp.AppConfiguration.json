    "_id": "EmailTemplates",
    "VerifyEmailTemplate": {
      "Subject": "Verify Iqra AI Registration",
      "Body": "<!DOCTYPE html>\n<html lang=\"en\" xmlns=\"http://www.w3.org/1999/xhtml\" xmlns:v=\"urn:schemas-microsoft-com:vml\" xmlns:o=\"urn:schemas-microsoft-com:office:office\">\n<head>\n    <meta charset=\"utf-8\">\n    <meta name=\"viewport\" content=\"width=device-width\">\n    <meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge\">\n    <meta name=\"color-scheme\" content=\"light dark\">\n    <meta name=\"supported-color-schemes\" content=\"light dark\">\n    <title>Verify Iqra AI Registration</title>\n\n    <!--[if !mso]><!-->\n    <link href=\"https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap\" rel=\"stylesheet\">\n    <!--<![endif]-->\n\n    <style>\n        :root {\n            /* Color Scheme */\n            --bg-color-dark: #1a1a1a;\n            --content-bg-dark: #2a2a2a;\n            --border-color-dark: #4e4e4e;\n            --text-primary-dark: #F7F6FB;\n            --text-secondary-dark: #dadada;\n            --accent-color-dark: #93b447;\n            --button-text-dark: #1a1a1a;\n\n            color-scheme: light dark;\n        }\n\n        /* Reset Styles */\n        body, table, td, a { -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; }\n        table, td { mso-table-lspace: 0pt; mso-table-rspace: 0pt; }\n        img { -ms-interpolation-mode: bicubic; border: 0; height: auto; line-height: 100%; outline: none; text-decoration: none; }\n        body { height: 100% !important; margin: 0 !important; padding: 0 !important; width: 100% !important; background-color: var(--bg-color-dark); }\n\n        /* Dark Mode Media Query */\n        @media (prefers-color-scheme: dark) {\n            body, .wrapper {\n                background-color: var(--bg-color-dark) !important;\n            }\n            .container, .content-box {\n                background-color: var(--content-bg-dark) !important;\n            }\n            .header-text, .body-text, .signature-text, .footer-text {\n                color: var(--text-primary-dark) !important;\n            }\n            .secondary-text {\n                 color: var(--text-secondary-dark) !important;\n            }\n            .email-border {\n                border: 1px solid var(--border-color-dark) !important;\n            }\n            .footer-bg {\n                background-color: var(--accent-color-dark) !important;\n            }\n            .footer-text, .footer-link {\n                color: #ffffff !important;\n            }\n            .founder-link {\n                color: #dadada !important;\n            }\n        }\n\n        /* Outlook Dark Mode Fix */\n        [data-ogsc] .wrapper, [data-ogsc] body {\n            background-color: var(--bg-color-dark) !important;\n        }\n        [data-ogsc] .container, [data-ogsc] .content-box {\n            background-color: var(--content-bg-dark) !important;\n        }\n        [data-ogsc] .header-text, [data-ogsc] .body-text, [data-ogsc] .signature-text {\n            color: var(--text-primary-dark) !important;\n        }\n        [data-ogsc] .secondary-text {\n            color: var(--text-secondary-dark) !important;\n        }\n        [data-ogsc] .email-border {\n            border: 1px solid var(--border-color-dark) !important;\n        }\n        [data-ogsc] .footer-bg {\n            background-color: var(--accent-color-dark) !important;\n        }\n        [data-ogsc] .footer-text, [data-ogsc] .footer-link {\n            color: #ffffff !important;\n        }\n        [data-ogsc] .founder-link {\n            color: #ffffff !important;\n        }\n\n    </style>\n</head>\n\n<body style=\"margin: 0 !important; padding: 0 !important; background-color: #1a1a1a;\">\n    <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" class=\"wrapper\">\n        <tr>\n            <td align=\"center\" style=\"padding: 20px 10px;\">\n                <!--[if (gte mso 9)|(IE)]>\n                <table align=\"center\" border=\"0\" cellspacing=\"0\" cellpadding=\"0\" width=\"600\">\n                <tr>\n                <td align=\"center\" valign=\"top\" width=\"600\">\n                <![endif]-->\n                <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"max-width: 600px;\" class=\"container\">\n                    <!-- LOGO -->\n                    <tr>\n                        <td align=\"center\" style=\"padding: 30px 0 30px 0;\">\n                            <img src=\"https://devapp.iqra.bot/img/logo/logo-colored-light.png\" alt=\"Iqra AI\" width=\"180\" style=\"display: block; width: 180px; max-width: 150px; min-width: 150px; font-family: 'Roboto', Helvetica, Arial, sans-serif; color: #ffffff; font-size: 24px;\" border=\"0\">\n                        </td>\n                    </tr>\n                    <!-- MAIN CONTENT -->\n                    <tr>\n                        <td align=\"center\" style=\"padding: 30px 30px 30px 30px; background-color: #2a2a2a;\" class=\"content-box email-border\">\n                            <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\">\n                                <!-- HEADING / GREETING -->\n                                <tr>\n                                    <td align=\"left\" style=\"font-family: 'Roboto', Helvetica, Arial, sans-serif; font-size: 14px; font-weight: 700; color: #F7F6FB; padding-bottom: 25px;\" class=\"header-text\">\n                                        Salam!\n                                    </td>\n                                </tr>\n                                <!-- BODY CONTENT PLACEHOLDER -->\n                                <tr>\n                                    <td align=\"left\" style=\"font-family: 'Roboto', Helvetica, Arial, sans-serif; font-size: 14px; font-weight: 400; line-height: 24px; color: #bebebe; padding-bottom: 20px;\" class=\"body-text secondary-text\">\n                                        Thank you for registering. Please click the button below to verify your email address and activate your account.\n                                    </td>\n                                </tr>\n                                <!-- BUTTON PLACEHOLDER -->\n                                <tr>\n                                    <td align=\"left\">\n                                        <table cellspacing=\"0\" cellpadding=\"0\" border=\"0\">\n                                            <tr>\n                                                <td align=\"center\" style=\"border-radius: 6px; background-color: #93b447;\" bgcolor=\"#93b447\">\n                                                    <a href=\"{{VERIFY_URL}}\" target=\"_blank\" style=\"font-size: 14px; font-family: 'Roboto', Helvetica, Arial, sans-serif; font-weight: 500; color: #1a1a1a; text-decoration: none; border-radius: 6px; padding: 10px 15px; border: 1px solid #93b447; display: inline-block;\">Verify Email Address</a>\n                                                </td>\n                                            </tr>\n                                        </table>\n                                    </td>\n                                </tr>\n                                <!-- Add space after the button -->\n                                <tr><td style=\"height: 20px;\"></td></tr>\n                                <!-- SIGNATURE -->\n                                <tr>\n                                    <td align=\"left\" style=\"font-family: 'Roboto', Helvetica, Arial, sans-serif; font-size: 14px; font-weight: 700; color: #F7F6FB;\" class=\"header-text\">\n                                        Jazakallah!<br>\n                                        <span style=\"color: #dadada;\" class=\"secondary-text\">\n                                            <a href=\"https://www.linkedin.com/in/abdofallah/\" target=\"_blank\" style=\"color: #eaeaea; text-decoration: underline;\" class=\"founder-link\">Abdullah bin Amir</a><br>\n                                            Founder - Iqra AI\n                                        </span>\n                                        \n                                    </td>\n                                </tr>\n                            </table>\n                        </td>\n                    </tr>\n                    <!-- FOOTER -->\n                    <tr>\n                        <!-- MODIFIED: Added green background, padding, and updated text/link colors for readability -->\n                        <td align=\"center\" style=\"padding: 30px; background-color: #93b447; margin-top: 20px;\" class=\"footer-bg\">\n                            <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\">\n                                <tr>\n                                    <td align=\"center\" style=\"font-family: 'Roboto', Helvetica, Arial, sans-serif; font-size: 14px; font-weight: 500; line-height: 20px; color: #ffffff;\" class=\"footer-text\">\n                                        Iqra AI, A change by <a href=\"https://badal.om\" target=\"_blank\" style=\"color: #ffffff; text-decoration: underline;\" class=\"footer-link\">Badal</a>.\n                                        <br><br>\n                                        <span style=\"font-size: 12px; color: #d9e9b3;\">This is an automated message.</span>\n                                    </td>\n                                </tr>\n                            </table>\n                        </td>\n                    </tr>\n                </table>\n                <!--[if (gte mso 9)|(IE)]>\n                </td>\n                </tr>\n                </table>\n                <![endif]-->\n            </td>\n        </tr>\n    </table>\n</body>\n</html>"
    },
    "WelcomeUserTemplate": {
      "Subject": "Welcome to Iqra AI!",
      "Body": "<!DOCTYPE html>\n<html lang=\"en\" xmlns=\"http://www.w3.org/1999/xhtml\" xmlns:v=\"urn:schemas-microsoft-com:vml\" xmlns:o=\"urn:schemas-microsoft-com:office:office\">\n<head>\n    <meta charset=\"utf-8\">\n    <meta name=\"viewport\" content=\"width=device-width\">\n    <meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge\">\n    <meta name=\"color-scheme\" content=\"light dark\">\n    <meta name=\"supported-color-schemes\" content=\"light dark\">\n    <title>Welcome to Iqra AI!</title>\n\n    <!--[if !mso]><!-->\n    <link href=\"https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap\" rel=\"stylesheet\">\n    <!--<![endif]-->\n\n    <style>\n        :root {\n            /* Color Scheme */\n            --bg-color-dark: #1a1a1a;\n            --content-bg-dark: #2a2a2a;\n            --border-color-dark: #4e4e4e;\n            --text-primary-dark: #F7F6FB;\n            --text-secondary-dark: #dadada;\n            --accent-color-dark: #93b447;\n            --button-text-dark: #1a1a1a;\n\n            color-scheme: light dark;\n        }\n\n        /* Reset Styles */\n        body, table, td, a { -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; }\n        table, td { mso-table-lspace: 0pt; mso-table-rspace: 0pt; }\n        img { -ms-interpolation-mode: bicubic; border: 0; height: auto; line-height: 100%; outline: none; text-decoration: none; }\n        body { height: 100% !important; margin: 0 !important; padding: 0 !important; width: 100% !important; background-color: var(--bg-color-dark); }\n\n        /* Dark Mode Media Query */\n        @media (prefers-color-scheme: dark) {\n            body, .wrapper {\n                background-color: var(--bg-color-dark) !important;\n            }\n            .container, .content-box {\n                background-color: var(--content-bg-dark) !important;\n            }\n            .header-text, .body-text, .signature-text, .footer-text {\n                color: var(--text-primary-dark) !important;\n            }\n            .secondary-text {\n                 color: var(--text-secondary-dark) !important;\n            }\n            .email-border {\n                border: 1px solid var(--border-color-dark) !important;\n            }\n            .footer-bg {\n                background-color: var(--accent-color-dark) !important;\n            }\n            .footer-text, .footer-link {\n                color: #ffffff !important;\n            }\n            .founder-link, .action-link {\n                color: #eaeaea !important;\n            }\n        }\n\n        /* Outlook Dark Mode Fix */\n        [data-ogsc] .wrapper, [data-ogsc] body {\n            background-color: var(--bg-color-dark) !important;\n        }\n        [data-ogsc] .container, [data-ogsc] .content-box {\n            background-color: var(--content-bg-dark) !important;\n        }\n        [data-ogsc] .header-text, [data-ogsc] .body-text, [data-ogsc] .signature-text {\n            color: var(--text-primary-dark) !important;\n        }\n        [data-ogsc] .secondary-text {\n            color: var(--text-secondary-dark) !important;\n        }\n        [data-ogsc] .email-border {\n            border: 1px solid var(--border-color-dark) !important;\n        }\n        [data-ogsc] .footer-bg {\n            background-color: var(--accent-color-dark) !important;\n        }\n        [data-ogsc] .footer-text, [data-ogsc] .footer-link {\n            color: #ffffff !important;\n        }\n        [data-ogsc] .founder-link, [data-ogsc] .action-link {\n            color: #eaeaea !important;\n        }\n\n    </style>\n</head>\n\n<body style=\"margin: 0 !important; padding: 0 !important; background-color: #1a1a1a;\">\n    <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" class=\"wrapper\">\n        <tr>\n            <td align=\"center\" style=\"padding: 20px 10px;\">\n                <!--[if (gte mso 9)|(IE)]>\n                <table align=\"center\" border=\"0\" cellspacing=\"0\" cellpadding=\"0\" width=\"600\">\n                <tr>\n                <td align=\"center\" valign=\"top\" width=\"600\">\n                <![endif]-->\n                <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"max-width: 600px;\" class=\"container\">\n                    <!-- LOGO -->\n                    <tr>\n                        <td align=\"center\" style=\"padding: 30px 0 30px 0;\">\n                            <img src=\"https://devapp.iqra.bot/img/logo/logo-colored-light.png\" alt=\"Iqra AI\" width=\"180\" style=\"display: block; width: 180px; max-width: 150px; min-width: 150px; font-family: 'Roboto', Helvetica, Arial, sans-serif; color: #ffffff; font-size: 24px;\" border=\"0\">\n                        </td>\n                    </tr>\n                    <!-- MAIN CONTENT -->\n                    <tr>\n                        <td align=\"center\" style=\"padding: 30px 30px 30px 30px; background-color: #2a2a2a;\" class=\"content-box email-border\">\n                            <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\">\n                                <!-- HEADING / GREETING -->\n                                <tr>\n                                    <td align=\"left\" style=\"font-family: 'Roboto', Helvetica, Arial, sans-serif; font-size: 14px; font-weight: 700; color: #F7F6FB; padding-bottom: 25px;\" class=\"header-text\">\n                                        Salam {{USER_NAME}}!\n                                    </td>\n                                </tr>\n                                <!-- BODY CONTENT -->\n                                <tr>\n                                    <td align=\"left\" style=\"font-family: 'Roboto', Helvetica, Arial, sans-serif; font-size: 14px; font-weight: 400; line-height: 24px; color: #bebebe; padding-bottom: 30px;\" class=\"body-text secondary-text\">\n                                        Welcome to Iqra AI! We are thrilled to have you on board. Your account is now active, and you can begin exploring the platform and building your conversational AI agents.\n                                        <br><br>\n                                        To help you get started, here are a couple of useful resources:\n                                    </td>\n                                </tr>\n                                \n                                <!-- ACTION LINKS WITH ICONS -->\n                                <tr>\n                                    <td align=\"left\">\n                                        <!-- Discord Link -->\n                                        <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\">\n                                            <tr>\n                                                <td width=\"40\" valign=\"middle\">\n                                                    <img src=\"https://cdn.prod.website-files.com/6257adef93867e50d84d30e2/66e3d80db9971f10a9757c99_Symbol.svg\" alt=\"Discord\" width=\"28\" height=\"28\" style=\"display: block;\">\n                                                </td>\n                                                <td valign=\"middle\" style=\"font-family: 'Roboto', Helvetica, Arial, sans-serif; font-size: 14px; line-height: 24px; color: #dadada;\" class=\"secondary-text\">\n                                                    <a href=\"https://discord.gg/UkKHtmqmMH\" target=\"_blank\" style=\"text-decoration: underline; color: #eaeaea;\" class=\"action-link\">Join our Discord community</a> to connect with other users and the development team.\n                                                </td>\n                                            </tr>\n                                        </table>\n                                        <!-- Spacer -->\n                                        <div style=\"height: 15px; line-height: 15px; font-size: 15px;\">&nbsp;</div>\n                                        <!-- Documentation Link -->\n                                        <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\">\n                                            <tr>\n                                                <td width=\"40\" valign=\"middle\">\n                                                    <img src=\"https://raw.githubusercontent.com/seanyeh/fontawesome-svgs/refs/heads/master/svg/question-circle-regular.svg\" alt=\"Docs\" width=\"28\" height=\"28\" style=\"display: block; filter: brightness(0) invert(1);\">\n                                                </td>\n                                                <td valign=\"middle\" style=\"font-family: 'Roboto', Helvetica, Arial, sans-serif; font-size: 14px; line-height: 24px; color: #dadada;\" class=\"secondary-text\">\n                                                    <a href=\"https://docs.iqra.bot/\" target=\"_blank\" style=\"text-decoration: underline; color: #eaeaea;\" class=\"action-link\">Visit the documentation</a> to learn more about the platform's features and capabilities.\n                                                </td>\n                                            </tr>\n                                        </table>\n                                    </td>\n                                </tr>\n\n                                <!-- Add space after the links -->\n                                <tr><td style=\"height: 30px;\"></td></tr>\n                                \n                                <!-- SIGNATURE -->\n                                <tr>\n                                    <td align=\"left\" style=\"font-family: 'Roboto', Helvetica, Arial, sans-serif; font-size: 14px; font-weight: 700; color: #F7F6FB;\" class=\"header-text\">\n                                        Jazakallah!<br>\n                                        <span style=\"color: #dadada;\" class=\"secondary-text\">\n                                            <a href=\"https://www.linkedin.com/in/abdofallah/\" target=\"_blank\" style=\"color: #eaeaea; text-decoration: underline;\" class=\"founder-link\">Abdullah bin Amir</a><br>\n                                            Founder - Iqra AI\n                                        </span>\n                                    </td>\n                                </tr>\n                            </table>\n                        </td>\n                    </tr>\n                    <!-- FOOTER -->\n                    <tr>\n                        <td align=\"center\" style=\"padding: 30px; background-color: #93b447; margin-top: 20px;\" class=\"footer-bg\">\n                            <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\">\n                                <tr>\n                                    <td align=\"center\" style=\"font-family: 'Roboto', Helvetica, Arial, sans-serif; font-size: 14px; font-weight: 500; line-height: 20px; color: #ffffff;\" class=\"footer-text\">\n                                        Iqra AI, A change by <a href=\"https://badal.om\" target=\"_blank\" style=\"color: #ffffff; text-decoration: underline;\" class=\"footer-link\">Badal</a>.\n                                        <br><br>\n                                        <span style=\"font-size: 12px; color: #d9e9b3;\">This is an automated message.</span>\n                                    </td>\n                                </tr>\n                            </table>\n                        </td>\n                    </tr>\n                </table>\n                <!--[if (gte mso 9)|(IE)]>\n                </td>\n                </tr>\n                </table>\n                <![endif]-->\n            </td>\n        </tr>\n    </table>\n</body>\n</html>"
    },
    "ResetPasswordTemplate": {
      "Subject": "Reset Your Iqra AI Password",
      "Body": "<!DOCTYPE html>\n<html lang=\"en\" xmlns=\"http://www.w3.org/1999/xhtml\" xmlns:v=\"urn:schemas-microsoft-com:vml\" xmlns:o=\"urn:schemas-microsoft-com:office:office\">\n<head>\n    <meta charset=\"utf-8\">\n    <meta name=\"viewport\" content=\"width=device-width\">\n    <meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge\">\n    <meta name=\"color-scheme\" content=\"light dark\">\n    <meta name=\"supported-color-schemes\" content=\"light dark\">\n    <title>Reset Your Iqra AI Password</title>\n\n    <!--[if !mso]><!-->\n    <link href=\"https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap\" rel=\"stylesheet\">\n    <!--<![endif]-->\n\n    <style>\n        :root {\n            /* Color Scheme */\n            --bg-color-dark: #1a1a1a;\n            --content-bg-dark: #2a2a2a;\n            --border-color-dark: #4e4e4e;\n            --text-primary-dark: #F7F6FB;\n            --text-secondary-dark: #dadada;\n            --accent-color-dark: #93b447;\n            --button-text-dark: #1a1a1a;\n\n            color-scheme: light dark;\n        }\n\n        /* Reset Styles */\n        body, table, td, a { -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; }\n        table, td { mso-table-lspace: 0pt; mso-table-rspace: 0pt; }\n        img { -ms-interpolation-mode: bicubic; border: 0; height: auto; line-height: 100%; outline: none; text-decoration: none; }\n        body { height: 100% !important; margin: 0 !important; padding: 0 !important; width: 100% !important; background-color: var(--bg-color-dark); }\n\n        /* Dark Mode Media Query */\n        @media (prefers-color-scheme: dark) {\n            body, .wrapper {\n                background-color: var(--bg-color-dark) !important;\n            }\n            .container, .content-box {\n                background-color: var(--content-bg-dark) !important;\n            }\n            .header-text, .body-text, .signature-text, .footer-text {\n                color: var(--text-primary-dark) !important;\n            }\n            .secondary-text {\n                 color: var(--text-secondary-dark) !important;\n            }\n            .email-border {\n                border: 1px solid var(--border-color-dark) !important;\n            }\n            .footer-bg {\n                background-color: var(--accent-color-dark) !important;\n            }\n            .footer-text, .footer-link {\n                color: #ffffff !important;\n            }\n            .founder-link {\n                color: #dadada !important;\n            }\n        }\n\n        /* Outlook Dark Mode Fix */\n        [data-ogsc] .wrapper, [data-ogsc] body {\n            background-color: var(--bg-color-dark) !important;\n        }\n        [data-ogsc] .container, [data-ogsc] .content-box {\n            background-color: var(--content-bg-dark) !important;\n        }\n        [data-ogsc] .header-text, [data-ogsc] .body-text, [data-ogsc] .signature-text {\n            color: var(--text-primary-dark) !important;\n        }\n        [data-ogsc] .secondary-text {\n            color: var(--text-secondary-dark) !important;\n        }\n        [data-ogsc] .email-border {\n            border: 1px solid var(--border-color-dark) !important;\n        }\n        [data-ogsc] .footer-bg {\n            background-color: var(--accent-color-dark) !important;\n        }\n        [data-ogsc] .footer-text, [data-ogsc] .footer-link {\n            color: #ffffff !important;\n        }\n        [data-ogsc] .founder-link {\n            color: #ffffff !important;\n        }\n\n    </style>\n</head>\n\n<body style=\"margin: 0 !important; padding: 0 !important; background-color: #1a1a1a;\">\n    <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" class=\"wrapper\">\n        <tr>\n            <td align=\"center\" style=\"padding: 20px 10px;\">\n                <!--[if (gte mso 9)|(IE)]>\n                <table align=\"center\" border=\"0\" cellspacing=\"0\" cellpadding=\